{
  "name": "cem-monorepo",
  "version": "1.4.0",
  "private": true,
  "description": "Claude Environment Manager (CEM) — backup, restore, manage and migrate Claude Code environments.",
  "type": "module",
  "license": "MIT",
  "author": "Luiz Dione and CEM Contributors",
  "homepage": "https://github.com/luizdione/CEM_software",
  "repository": {
    "type": "git",
    "url": "https://github.com/luizdione/CEM_software.git"
  },
  "bugs": {
    "url": "https://github.com/luizdione/CEM_software/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @cem/cli build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build:cli": "pnpm --filter @cem/cli build",
    "build:desktop": "pnpm --filter @cem/desktop build",
    "dev:cli": "pnpm --filter @cem/cli dev",
    "dev:desktop": "pnpm --filter @cem/desktop dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache && rm -rf node_modules",
    "cli": "pnpm --filter @cem/cli exec node dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
